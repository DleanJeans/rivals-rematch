{
  "manifest_version": 3,
  "name": "Rivals Rematch",
  "version": "0.13.3",
  "description": "Remembers the players in your Marvel Rivals lobbies (from rivalsdata.com) and recognises them again when their names are hidden during the ban phase. All data stays on your machine.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://rivalsdata.com/*",
    "https://www.rivalsdata.com/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_title": "Rivals Rematch",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://rivalsdata.com/*",
        "https://www.rivalsdata.com/*"
      ],
      "js": [
        "lib/shared.js",
        "lib/store.js",
        "lib/detailui.js",
        "content/scrape.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "data/players.json"
      ],
      "matches": [
        "https://rivalsdata.com/*",
        "https://www.rivalsdata.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  }
}
